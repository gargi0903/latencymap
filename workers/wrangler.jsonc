{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "latencymap-probe",
  "main": "worker.ts",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "vars": {
    "PROBE_REGION": "cloudflare"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "iad": {
      "name": "latencymap-probe-iad",
      "placement": {
        "mode": "targeted",
        "region": "aws:us-east-1"
      },
      "vars": {
        "PROBE_REGION": "iad",
        "PLACEMENT_REGION": "aws:us-east-1"
      }
    },
    "lhr": {
      "name": "latencymap-probe-lhr",
      "placement": {
        "mode": "targeted",
        "region": "aws:eu-west-2"
      },
      "vars": {
        "PROBE_REGION": "lhr",
        "PLACEMENT_REGION": "aws:eu-west-2"
      }
    },
    "sin": {
      "name": "latencymap-probe-sin",
      "placement": {
        "mode": "targeted",
        "region": "aws:ap-southeast-1"
      },
      "vars": {
        "PROBE_REGION": "sin",
        "PLACEMENT_REGION": "aws:ap-southeast-1"
      }
    },
    "syd": {
      "name": "latencymap-probe-syd",
      "placement": {
        "mode": "targeted",
        "region": "aws:ap-southeast-2"
      },
      "vars": {
        "PROBE_REGION": "syd",
        "PLACEMENT_REGION": "aws:ap-southeast-2"
      }
    },
    "gru": {
      "name": "latencymap-probe-gru",
      "placement": {
        "mode": "targeted",
        "region": "aws:sa-east-1"
      },
      "vars": {
        "PROBE_REGION": "gru",
        "PLACEMENT_REGION": "aws:sa-east-1"
      }
    }
  }
}
