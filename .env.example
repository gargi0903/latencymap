# Copy to .env.local for development. In production, set these in Vercel project settings.

# -----------------------------------------------------------------------------
# Required in production (Vercel)
# -----------------------------------------------------------------------------

# Your Cloudflare Workers subdomain (without https://).
# Example: if probes are at https://latencymap-probe-iad.<subdomain>/probe,
# set PROBE_WORKERS_SUBDOMAIN=<subdomain>
PROBE_WORKERS_SUBDOMAIN=

# Shared secret sent to probes as x-probe-secret. Use the same value in Vercel
# and every Cloudflare Worker environment.
PROBE_SECRET=

# -----------------------------------------------------------------------------
# Local development only (optional)
# -----------------------------------------------------------------------------

# npm run dev:local starts the Next.js app and a local Node probe together.
# Region metadata is committed in lib/probe-regions.ts.
# LOCAL_PROBE_ENDPOINT=http://127.0.0.1:8787/probe
# PROBE_REGION=local
# PROBE_PORT=8787
# APP_PORT=3000
