# Copy to .env.local for development. In production, set these in Vercel project settings.

# Your Cloudflare Workers subdomain (without https://).
# Example: if Workers are at https://latencymap-probe-iad.<subdomain>/probe,
# set PROBE_WORKERS_SUBDOMAIN=<subdomain>
# Required for real regional tests (local and production).
PROBE_WORKERS_SUBDOMAIN=

# Shared secret sent to Workers as x-probe-secret. Use the same value in Vercel
# and every Cloudflare Worker environment.
PROBE_SECRET=

# Optional local app bind overrides (used by npm run dev:local)
# APP_HOST=::
# APP_PORT=3000
