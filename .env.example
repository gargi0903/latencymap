# Copy to .env.local for development. In production, set these in Vercel project settings.

# -----------------------------------------------------------------------------
# Required in production (Vercel)
# -----------------------------------------------------------------------------

# Coordinator Worker /probe URL. Required in production.
# PROBE_COORDINATOR_ENDPOINT=https://latencymap-probe-coordinator.<your-workers-subdomain>.workers.dev/probe

# Shared secret sent to probes as x-probe-secret. Required in any environment that
# calls probes. Use the same value in Vercel and every Cloudflare Worker environment.
PROBE_SECRET=

# -----------------------------------------------------------------------------
# Local development only (optional)
# -----------------------------------------------------------------------------

# npm run dev:local starts the Next.js app and a local Node probe together.
# Region metadata is committed in lib/probe-regions.ts.
# LOCAL_PROBE_ENDPOINT=http://127.0.0.1:8787/probe
# PROBE_REGION=local
# PROBE_PORT=8787
# APP_PORT=3000

# -----------------------------------------------------------------------------
# Vercel deployment (configured in vercel.json, not env vars)
# -----------------------------------------------------------------------------
# Fluid Compute and function region (iad1) are enabled in vercel.json.
# /api/tests maxDuration is 30s to allow parallel regional probes.
