# Neon Postgres. If unset, local dev stores test runs in .data/latencymap.json.
DATABASE_URL=

# JSON array of real deployed probe endpoints. Required to run tests.
# See probes/regions.example.json for a 5-region template.
# [{"id":"iad","label":"US East (Ashburn)","lat":39.0438,"lng":-77.4874,"endpoint":"https://latencymap-probe-iad.<your-workers-subdomain>.workers.dev/probe"}]
PROBE_ENDPOINTS=

# Optional shared secret sent to probes as x-probe-secret.
PROBE_SECRET=
