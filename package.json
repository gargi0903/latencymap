{
  "name": "latencymap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.probes.json",
    "lint": "eslint app components lib probes",
    "test": "vitest run",
    "probe:cf:dev": "wrangler dev --config probes/cloudflare/wrangler.jsonc",
    "probe:cf:deploy": "wrangler deploy --config probes/cloudflare/wrangler.jsonc",
    "probe:cf:deploy:iad": "wrangler deploy --config probes/cloudflare/wrangler.jsonc --env iad",
    "probe:cf:deploy:lhr": "wrangler deploy --config probes/cloudflare/wrangler.jsonc --env lhr",
    "probe:cf:deploy:sin": "wrangler deploy --config probes/cloudflare/wrangler.jsonc --env sin",
    "probe:cf:deploy:syd": "wrangler deploy --config probes/cloudflare/wrangler.jsonc --env syd",
    "probe:cf:deploy:gru": "wrangler deploy --config probes/cloudflare/wrangler.jsonc --env gru",
    "probe:cf:deploy:regions": "npm run probe:cf:deploy:iad && npm run probe:cf:deploy:lhr && npm run probe:cf:deploy:sin && npm run probe:cf:deploy:syd && npm run probe:cf:deploy:gru"
  },
  "dependencies": {
    "next": "^15.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-istanbul": "^3.2.4",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.0.4",
    "happy-dom": "^15.11.7",
    "postcss": "^8.5.21",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.25.0"
  }
}
