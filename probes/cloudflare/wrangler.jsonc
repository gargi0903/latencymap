{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "latencymap-probe",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "vars": {
    "PROBE_REGION": "cloudflare"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "iad": {
      "name": "latencymap-probe-iad",
      "workers_dev": true,
      "placement": {
        "mode": "targeted",
        "region": "aws:us-east-1"
      },
      "vars": {
        "PROBE_REGION": "iad",
        "PLACEMENT_REGION": "aws:us-east-1"
      }
    },
    "lhr": {
      "name": "latencymap-probe-lhr",
      "workers_dev": true,
      "placement": {
        "mode": "targeted",
        "region": "aws:eu-west-2"
      },
      "vars": {
        "PROBE_REGION": "lhr",
        "PLACEMENT_REGION": "aws:eu-west-2"
      }
    },
    "sin": {
      "name": "latencymap-probe-sin",
      "workers_dev": true,
      "placement": {
        "mode": "targeted",
        "region": "aws:ap-southeast-1"
      },
      "vars": {
        "PROBE_REGION": "sin",
        "PLACEMENT_REGION": "aws:ap-southeast-1"
      }
    },
    "syd": {
      "name": "latencymap-probe-syd",
      "workers_dev": true,
      "placement": {
        "mode": "targeted",
        "region": "aws:ap-southeast-2"
      },
      "vars": {
        "PROBE_REGION": "syd",
        "PLACEMENT_REGION": "aws:ap-southeast-2"
      }
    },
    "gru": {
      "name": "latencymap-probe-gru",
      "workers_dev": true,
      "placement": {
        "mode": "targeted",
        "region": "aws:sa-east-1"
      },
      "vars": {
        "PROBE_REGION": "gru",
        "PLACEMENT_REGION": "aws:sa-east-1"
      }
    },
    "coordinator": {
      "name": "latencymap-probe-coordinator",
      "main": "src/coordinator.ts",
      "workers_dev": true,
      "services": [
        { "binding": "PROBE_IAD", "service": "latencymap-probe-iad" },
        { "binding": "PROBE_LHR", "service": "latencymap-probe-lhr" },
        { "binding": "PROBE_SIN", "service": "latencymap-probe-sin" },
        { "binding": "PROBE_SYD", "service": "latencymap-probe-syd" },
        { "binding": "PROBE_GRU", "service": "latencymap-probe-gru" }
      ],
      "vars": {
        "PROBE_REGION": "coordinator"
      }
    }
  }
}
